{
    "action_manifest_version": 1,
    "controller_type": "knuckles",
    "description": "VRCRecorder default bindings for Valve Index controllers",
    "interaction_profile": "/interaction_profiles/valve/index_controller",
    "name": "VRCRecorder Default Bindings",
    "options": {},
    "category": "steamvr_input",
    "alias_info": {},
    "app_key": "com.vrc-recorder.overlay",
    "bindings": {
        "/actions/vrc_recorder": {
            "sources": [
                {
                    "path": "/user/hand/right/input/a",
                    "mode": "button",
                    "parameters": {
                        "haptic_amplitude": "0"
                    },
                    "inputs": {
                        "double": {
                            "output": "/actions/vrc_recorder/in/toggle_record"
                        }
                    }
                }
            ]
        }
    }
}
