{
    "action_manifest_version": 1,
    "controller_type": "pico4_controller",
    "description": "VRCRecorder default bindings for PICO 3 / 4 / 4 Pro / 4 Ultra controllers",
    "interaction_profile": "/interaction_profiles/bytedance/pico4_controller",
    "name": "VRCRecorder PICO Bindings",
    "options": {},
    "category": "steamvr_input",
    "alias_info": {},
    "app_key": "com.vrc-recorder.overlay",
    "bindings": {
        "/actions/vrc_recorder": {
            "sources": [
                {
                    "path": "/user/hand/left/input/thumbstick",
                    "mode": "joystick",
                    "parameters": {
                        "haptic_amplitude": "0.3"
                    },
                    "inputs": {
                        "click": {
                            "output": "/actions/vrc_recorder/in/toggle_record"
                        }
                    }
                }
            ]
        }
    }
}
