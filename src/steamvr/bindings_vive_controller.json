{
    "action_manifest_version": 1,
    "controller_type": "vive_controller",
    "description": "VRCRecorder default bindings for HTC Vive / Focus Vision controllers",
    "interaction_profile": "/interaction_profiles/htc/vive_focus3_controller",
    "name": "VRCRecorder Vive Bindings",
    "options": {},
    "category": "steamvr_input",
    "alias_info": {},
    "app_key": "com.vrc-recorder.overlay",
    "bindings": {
        "/actions/vrc_recorder": {
            "sources": [
                {
                    "path": "/user/hand/right/input/b",
                    "mode": "button",
                    "parameters": {
                        "haptic_amplitude": "0.3"
                    },
                    "inputs": {
                        "click": {
                            "output": "/actions/vrc_recorder/in/toggle_record"
                        }
                    }
                }
            ]
        }
    }
}
